rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: donations
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required) - Donor name or 'Hamba Allah'
    //   - amount: number (required) - Donation amount in JPY
    //   - date: timestamp (required) - Date of donation
    //   - status: string (required, ['pending', 'verified']) - Verification status
    //   - loc: string (optional) - Donor location
    //   - phone: string (optional) - Donor phone number (PII)
    //   - isAnonymous: bool (optional) - Whether to hide the name
    //   - proofUrl: string (optional) - URL to proof of transfer
    //   - remarks: string (optional) - Admin notes
    //
    // Collection: stats
    // Document ID: global
    // Fields:
    //   - totalNeed: number (required) - Goal amount
    //   - baseVerified: number (required) - Initial verified amount
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'rictau.jp@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isCampaignOpen(campaignId) {
      let camp = get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
      return !('isClosed' in camp && camp.isClosed == true) &&
             (!('donationDeadline' in camp) || camp.donationDeadline == null || request.time < camp.donationDeadline);
    }

    function donationsOpen(data) {
      return ('campaignId' in data && exists(/databases/$(database)/documents/campaigns/$(data.campaignId)))
        ? isCampaignOpen(data.campaignId)
        : (!('isClosed' in get(/databases/$(database)/documents/stats/global).data && get(/databases/$(database)/documents/stats/global).data.isClosed == true));
    }

    function isValidPublicDonation(data) {
      return data.keys().hasAll(['name', 'amount', 'date', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.date is timestamp &&
             data.status in ['pending', 'verified'] &&
             (!('campaignId' in data) || (data.campaignId is string && data.campaignId.size() < 100)) &&
             (!('loc' in data) || (data.loc is string && data.loc.size() < 100)) &&
             (!('isAnonymous' in data) || data.isAnonymous is bool) &&
             (!('package' in data) || (data.package is string && data.package.size() < 100)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() < 100)) &&
             (!('originalCurrency' in data) || data.originalCurrency in ['JPY', 'IDR']) &&
             (!('originalAmount' in data) || data.originalAmount == null || (data.originalAmount is number && data.originalAmount >= 0)) &&
             // Prevent PII from being written to the public collection on create
             (!('phone' in data) && !('email' in data) && !('proofUrl' in data) && !('remarks' in data));
    }

    function isValidPrivateDonation(data) {
      return (!('email' in data) || (data.email is string && data.email.size() < 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 50)) &&
             (!('proofUrl' in data) || (data.proofUrl is string && data.proofUrl.size() < 1000)) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() < 1000)) &&
             (!('campaignId' in data) || (data.campaignId is string && data.campaignId.size() < 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /campaigns/{campaignId} {
      // Public can read campaigns
      allow read: if true;
      
      // Admins can configure campaigns
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      // Public can read donations for the public ledger (strictly non-PII)
      allow read: if true;
      
      // Anyone can create a public donation entry while donations are open.
      // Admins can always create (manual entry / re-opening case).
      allow create: if isValidPublicDonation(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && (donationsOpen(request.resource.data) || isAdmin());
      
      // Only admins can update or delete donations
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /donations_private/{donationId} {
      // ONLY authenticated admins can read private donor data (email, phone, proofUrl, remarks)
      allow read: if isAdmin();
      
      // Anyone can create a private donation record during submission while donations are open
      allow create: if isValidPrivateDonation(request.resource.data)
                    && (donationsOpen(request.resource.data) || isAdmin());
      
      // Only admins can update or delete private donor records
      allow update: if isAdmin() && isValidPrivateDonation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /stats/{statId} {
      // Public can read stats (legacy backward compatibility)
      allow read: if true;
      
      // All admins can configure program settings
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Users can read their own document; admins can read any user document
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Only Superadmin can create, update, or delete user roles and profiles
      allow write: if isSuperAdmin();
    }
  }
}
