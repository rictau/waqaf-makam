{
  "name": "mosque-dev-functions",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync(p.join(__dirname,'src/index.html')))fs.copyFileSync(p.join(__dirname,'src/index.html'),p.join(__dirname,'lib/index.html'));\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "private": true
}
